# Public site URL. Canonicals, the sitemap, RSS and JSON-LD use it. www is the
# host that serves the site (aboast.com redirects there).
NEXT_PUBLIC_APP_URL=https://www.aboast.com
# The app, for the sign-up / log-in links.
NEXT_PUBLIC_SAAS_URL=https://app.aboast.com

# Only needed for /api/cron/publish, the on-demand blog writer.
ANTHROPIC_API_KEY=
# Any long random string (openssl rand -base64 32). The writer refuses requests without it.
CRON_SECRET=
# Fine-grained GitHub token for edvin1811/aboast with Contents: Read and write.
GITHUB_TOKEN=
# Optional overrides (defaults shown).
# BLOG_REPO=edvin1811/aboast
# BLOG_BRANCH=main
# BLOG_PATH=frontend/content/blog
