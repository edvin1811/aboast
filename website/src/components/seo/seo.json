{
  "collectionName": "components_seo_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search",
    "description": "SEO metadata for pages and blog posts"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "required": true
    },
    "metaDescription": {
      "type": "text",
      "required": true
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "canonicalURL": {
      "type": "string",
      "required": false
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    }
  }
}
